<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RazorPagesApp</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-white text-slate-900">
    <header class="border-b border-slate-200">
        <nav class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-4">
            <a class="font-semibold" asp-area="" asp-page="/Index">RazorPagesApp</a>
            <a class="text-slate-600" asp-area="" asp-page="/Privacy">Privacy</a>
        </nav>
    </header>
    <main class="mx-auto max-w-5xl px-6 py-8">
        @RenderBody()
    </main>
    <footer class="border-t border-slate-200 px-6 py-4 text-sm text-slate-500">
        &copy; 2026 - RazorPagesApp - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
