{
  "name": "kumicraft",
  "version": "1.0.6",
  "description": "Visual editor for React + Vite projects: design on a live Canvas, KumiCraft writes the code in your own files.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "kumicraft": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@fastify/static": "10.1.9",
    "@fastify/websocket": "11.3.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "chokidar": "5.0.0",
    "cross-spawn": "7.0.6",
    "diff": "9.0.0",
    "env-paths": "4.0.0",
    "fastify": "5.12.8",
    "ignore": "7.0.12",
    "magic-string": "0.30.21",
    "nanoid": "6.0.2",
    "open": "11.0.4",
    "pino": "10.4.0",
    "postcss": "8.5.29",
    "postcss-less": "6.0.0",
    "postcss-scss": "4.0.9",
    "write-file-atomic": "7.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kumicraft/server": "workspace:*",
    "@kumicraft/shared": "workspace:*",
    "@kumicraft/studio": "workspace:*",
    "@types/node": "22.20.5",
    "tsdown": "0.23.1"
  },
  "scripts": {
    "build": "tsdown"
  },
  "keywords": [
    "react",
    "vite",
    "tailwind",
    "visual-editor",
    "design",
    "no-code",
    "studio"
  ]
}
