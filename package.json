{
  "name": "reactcraft-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ReactCraft Local: local-first AI design studio that exports React + TypeScript + Tailwind code",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/model && tsc --noEmit -p packages/server && tsc --noEmit -p packages/studio && tsc --noEmit -p packages/cli && tsc --noEmit -p e2e && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "bench": "vitest bench --run --reporter=default --reporter=json --outputFile.json=bench-results/bench.json",
    "trace": "node scripts/trace.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm check:i18n && pnpm test && pnpm trace && pnpm build",
    "changeset": "changeset",
    "fixtures:check": "node scripts/vg/build-target-fixtures.mjs",
    "gen:large-workspace": "node scripts/gen-large-workspace.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@reactcraft/model": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "write-file-atomic": "7.0.1"
  }
}
