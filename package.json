{
  "name": "reactcraft-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ReactCraft Local: local-first AI design studio that exports React + TypeScript + Tailwind code",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "node scripts/not-implemented.mjs dev WP-0.03",
    "build": "node scripts/not-implemented.mjs build WP-0.03",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/model && tsc --noEmit -p packages/server && tsc --noEmit -p packages/studio && tsc --noEmit -p packages/cli",
    "test": "node scripts/not-implemented.mjs test WP-0.06",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e WP-0.06",
    "check:i18n": "node scripts/not-implemented.mjs check:i18n WP-0.05",
    "bench": "node scripts/not-implemented.mjs bench WP-0.06",
    "trace": "node scripts/not-implemented.mjs trace WP-0.06",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
