{
  "name": "kumicraft-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "KumiCraft Local: a visual studio that edits the source code of a real React + Vite + Tailwind project, with AI through a local agent",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "package": "pnpm build && pnpm --filter kumicraft pack --pack-destination artifacts",
    "check:package": "node scripts/check-package.mjs",
    "sbom": "node scripts/sbom.mjs",
    "release:check": "pnpm audit --prod --audit-level=high && pnpm sbom && pnpm package && pnpm check:package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/bridge && tsc --noEmit -p packages/server && tsc --noEmit -p packages/studio && tsc --noEmit -p packages/cli && tsc --noEmit -p e2e && tsc --noEmit -p tour",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:network": "pnpm build && node scripts/e2e-network.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "bench": "vitest bench --run --reporter=default --reporter=json --outputFile.json=bench-results/bench.json",
    "bench:ui": "pnpm build && playwright test e2e/perf --workers=1",
    "tour": "playwright test -c tour/playwright.config.js",
    "test:real": "pnpm build && playwright test e2e/real --workers=1 --project=chromium",
    "trace": "node scripts/trace.mjs",
    "gen:palette": "node scripts/gen-tailwind-palette.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm check:i18n && pnpm test && pnpm trace && pnpm build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "bootstrap": "5.3.3",
    "compression": "1.8.2",
    "eslint": "10.12.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lefthook": "2.2.1",
    "less": "4.2.1",
    "prettier": "3.9.10",
    "pug": "3.0.4",
    "react-router": "7.18.4",
    "sass": "1.83.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "write-file-atomic": "7.0.1"
  }
}
